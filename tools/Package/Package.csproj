<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Package</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- ContentTool's OWN staging and validation, compiled in: the packager a modder runs and the
         rule the offline gate measures have to be the same code, or the gate proves nothing about
         what ships. Deliberately free of UnityEngine types, same arrangement as tests\. -->
    <Compile Include="..\..\src\Project\Package.cs" Link="Package.cs" />
  </ItemGroup>
</Project>
